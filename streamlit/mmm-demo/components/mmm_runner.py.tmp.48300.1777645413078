"""MMM 模型封裝：負責資料準備、模型初始化、擬合和結果提取。"""

from __future__ import annotations

import os
import numpy as np
import pandas as pd
from pymc_extras.prior import Prior
from pymc_marketing.mmm import GeometricAdstock, LogisticSaturation
from pymc_marketing.mmm.multidimensional import MMM

SAVE_PATH = os.path.join(os.path.dirname(__file__), "..", "data", "fitted_mmm.nc")


DATASETS = {
    "mock_cgp（真實頻道名稱）": {
        "file": "data/mock_cgp_data.csv",
        "date_col": "Weeks",
        "target_col": "target1",
        "channel_cols": ["Google Search", "DV360", "Facebook", "AMS", "TV", "VOD", "OOH", "Radio"],
        "control_cols": ["Numeric Distribution", "RSP", "Promotion"],
    },
}


def load_sample_data(dataset_name: str = "mock_cgp（真實頻道名稱）") -> tuple[pd.DataFrame, dict]:
    """載入範例資料，回傳 (dataframe, dataset_meta)。"""
    meta = DATASETS[dataset_name]
    df = pd.read_csv(meta["file"], parse_dates=[meta["date_col"]])
    df = df.rename(columns={meta["date_col"]: "date_week", meta["target_col"]: "y"})

    # 保留需要的欄位，丟棄其他目標欄（如 target2, target_seasonal 等）
    keep_cols = ["date_week", "y"] + meta["channel_cols"] + meta["control_cols"]
    df = df[[c for c in keep_cols if c in df.columns]]

    # 過濾掉全為零的頻道（避免 prior_sigma=0 導致 HalfNormal 報錯）
    active_channels = [c for c in meta["channel_cols"] if df[c].sum() > 0]
    dropped = set(meta["channel_cols"]) - set(active_channels)
    meta = {**meta, "channel_cols": active_channels, "_dropped_channels": list(dropped)}

    df["t"] = range(len(df))
    return df, meta


def prepare_features(data: pd.DataFrame) -> tuple[pd.DataFrame, pd.Series]:
    """將原始資料分離為特徵 X 和目標 y。"""
    X = data.drop("y", axis=1)
    y = data["y"]
    return X, y


def build_mmm(
    data: pd.DataFrame,
    channel_columns: list[str],
    control_columns: list[str],
    l_max: int = 8,
    yearly_seasonality: int = 2,
) -> MMM:
    """根據資料和設定初始化 MMM 模型。"""
    X, y = prepare_features(data)

    total_spend = data[channel_columns].sum(axis=0)
    spend_share = total_spend / total_spend.sum()
    n_channels = len(channel_columns)
    prior_sigma = (n_channels * spend_share).to_numpy()

    model_config = {
        "intercept": Prior("Normal", mu=0.5, sigma=0.2),
        "saturation_beta": Prior("HalfNormal", sigma=prior_sigma, dims="channel"),
        "gamma_control": Prior("Normal", mu=0, sigma=0.05, dims="control"),
        "gamma_fourier": Prior("Laplace", mu=0, b=0.2, dims="fourier_mode"),
        "likelihood": Prior("Normal", sigma=Prior("HalfNormal", sigma=6), dims="date"),
    }

    mmm = MMM(
        model_config=model_config,
        sampler_config={"progressbar": True},
        date_column="date_week",
        adstock=GeometricAdstock(l_max=l_max),
        saturation=LogisticSaturation(),
        channel_columns=channel_columns,
        control_columns=control_columns,
        yearly_seasonality=yearly_seasonality,
    )

    mmm.build_model(X, y)
    mmm.add_original_scale_contribution_variable(
        [
            "y",
            "intercept_contribution",
            "control_contribution",
            "channel_contribution",
            "fourier_contribution",
            "yearly_seasonality_contribution",
        ]
    )
    return mmm


def fit_mmm(
    mmm: MMM,
    data: pd.DataFrame,
    draws: int = 500,
    chains: int = 2,
    target_accept: float = 0.9,
    random_seed: int = 42,
    tune: int = 1000,
    on_draw: callable | None = None,
) -> MMM:
    """執行 MCMC 採樣（不含後驗預測）。

    on_draw: 每完成一個 draw 呼叫一次，傳入 0.0–1.0 的進度值。
             tune 階段不計入進度。
    """
    X, y = prepare_features(data)
    rng = np.random.default_rng(seed=random_seed)

    completed_draws = [0]
    total_draws = draws * chains

    def _callback(trace, draw):
        # draw.draw_idx < tune 時是 tuning 階段，不計入進度
        if draw.draw_idx >= tune:
            completed_draws[0] += 1
            if on_draw is not None:
                on_draw(min(completed_draws[0] / total_draws, 1.0))

    mmm.fit(
        X=X, y=y,
        draws=draws, tune=tune, chains=chains,
        target_accept=target_accept,
        random_seed=rng,
        callback=_callback,
    )
    return mmm


def sample_posterior_predictive(mmm: MMM, data: pd.DataFrame) -> MMM:
    """計算後驗預測（採樣後單獨執行）。"""
    X, _ = prepare_features(data)
    mmm.sample_posterior_predictive(X, extend_idata=True, combined=True)
    return mmm


def get_channel_roas(mmm: MMM, data: pd.DataFrame) -> pd.DataFrame:
    """計算各頻道的 ROAS（廣告花費回報率）。"""
    post = mmm.idata.posterior
    channel_cols = mmm.channel_columns

    roas_data = []
    for i, ch in enumerate(channel_cols):
        contribution = float(
            post["channel_contribution_original_scale"]
            .sel(channel=ch)
            .mean(("chain", "draw"))
            .sum()
        )
        total_spend = float(data[ch].sum())
        roas = contribution / total_spend if total_spend > 0 else 0.0
        roas_data.append({"頻道": ch, "總貢獻（銷售額）": contribution, "總花費": total_spend, "ROAS": roas})

    return pd.DataFrame(roas_data)


def save_mmm(mmm: MMM, path: str = SAVE_PATH) -> str:
    """將擬合好的 MMM 存成 NetCDF 檔案，回傳存檔路徑。"""
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    mmm.save(path)
    return path


def load_mmm(path: str = SAVE_PATH) -> MMM:
    """從 NetCDF 檔案載入已擬合的 MMM。"""
    return MMM.load(path)


def saved_model_exists(path: str = SAVE_PATH) -> bool:
    """檢查是否有存檔的模型。"""
    return os.path.exists(path)
